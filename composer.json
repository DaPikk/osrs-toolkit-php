{
    "name": "dapikk/osrs-toolkit-php",
    "description": "Modernized fork of the official OpenSRS PHP Toolkit with PHP 7.4-8.4 compatibility, fixes and improvements",
    "type": "library",
    "homepage": "https://github.com/DaPikk/osrs-toolkit-php",
    "license": "MIT",
    "keywords": [
        "opensrs",
        "domains",
        "api",
        "php7",
        "php8"
    ],
    "authors": [
        {
            "name": "Colin Campbell",
            "email": "ccampbell@tucows.com",
            "homepage": "https://github.com/opensrs",
            "role": "Original Author"
        },
        {
            "name": "Kris Atkinson",
            "email": "katkinson@tucows.com",
            "homepage": "https://github.com/opensrs",
            "role": "Original Author"
        },
        {
            "name": "Kristjan T.",
            "homepage": "https://github.com/DaPikk",
            "role": "Fork Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/DaPikk/osrs-toolkit-php/issues",
        "source": "https://github.com/DaPikk/osrs-toolkit-php"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-openssl": "*",
        "mustangostang/spyc": "^0.5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.5"
    },
    "replace": {
        "opensrs/osrs-toolkit-php": "self.version"
    },
    "autoload": {
        "psr-4": {
            "opensrs\\": "opensrs"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
